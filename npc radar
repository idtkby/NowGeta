    radarObjects.localMarkStroke = newDrawObj('Quad', {Color = RADAR_THEME.Local_Marker; Filled = false; Thickness = 2; Visible = true; ZIndex = 304;})
else
    radarObjects.localMark = newDrawObj('Circle', {Color = RADAR_THEME.Local_Marker; Filled = true; NumSides = 20; Radius = markerScale * 3; Visible = true; ZIndex = 305;})
    radarObjects.localMarkStroke = newDrawObj('Circle', {Color = RADAR_THEME.Local_Marker; Filled = false; NumSides = 20; Radius = markerScale * 3; Visible = true; ZIndex = 304;})
end

local function updateRadarLines()
    for _, l in ipairs(radarLines) do removeDrawObj(l) end
    radarLines = {}
    if not RADAR_LINES then return end
    
    local lineCount = math.floor(RADAR_RADIUS / (RADAR_SCALE * RADAR_LINE_DISTANCE))
    for i = 1, lineCount do
        local lineRadius = i * (RADAR_SCALE * RADAR_LINE_DISTANCE)
        if lineRadius < RADAR_RADIUS then
            local line = newDrawObj('Circle', {
                Color = RADAR_THEME.Distance_Lines; Position = radarPosition; Radius = lineRadius;
                Filled = false; Visible = true; Transparency = (i % 4 == 0) and 0.6 or 0.2; NumSides = 40; Thickness = 1; ZIndex = 300;
            })
            table.insert(radarLines, line)
        end
    end
end

if RADAR_LINES then
    radarObjects.horizontalLine = newDrawObj('Line', {Color = RADAR_THEME.Cardinal_Lines; Visible = true; Thickness = 1; Transparency = 0.2; ZIndex = 300;})
    radarObjects.verticalLine = newDrawObj('Line', {Color = RADAR_THEME.Cardinal_Lines; Visible = true; Thickness = 1; Transparency = 0.2; ZIndex = 300;})
    updateRadarLines()
end

if CARDINAL_DISPLAY then
    radarObjects.directionN = newDrawObj('Text', {Center = true; Color = Color3.fromRGB(255, 75, 75); Font = Drawing.Fonts.UI; Outline = true; Size = 16; Text = 'N'; Visible = true; ZIndex = 303;})
    radarObjects.directionS = newDrawObj('Text', {Center = true; Color = Color3.new(1,1,1); Font = Drawing.Fonts.UI; Outline = true; Size = 14; Text = 'S'; Visible = true; ZIndex = 303;})
    radarObjects.directionW = newDrawObj('Text', {Center = true; Color = Color3.new(1,1,1); Font = Drawing.Fonts.UI; Outline = true; Size = 14; Text = 'W'; Visible = true; ZIndex = 303;})
    radarObjects.directionE = newDrawObj('Text', {Center = true; Color = Color3.new(1,1,1); Font = Drawing.Fonts.UI; Outline = true; Size = 14; Text = 'E'; Visible = true; ZIndex = 303;})
end

local function setRadarScale()
    markerScale = math.clamp(RADAR_SCALE, MARKER_SCALE_MIN, MARKER_SCALE_MAX) * MARKER_SCALE_BASE
    updateRadarLines()
    if USE_QUADS then
        scaleVec = newV2(markerScale, markerScale)
        quadPointA = newV2(0, 5)   * scaleVec
        quadPointB = newV2(4, -5)  * scaleVec
        quadPointC = newV2(0, -3)  * scaleVec
        quadPointD = newV2(-4, -5) * scaleVec
    else
        radarObjects.localMark.Radius = markerScale * 3
        radarObjects.localMarkStroke.Radius = markerScale * 3
    end
end

local function updateRadarSize()
    radarObjects.main.Radius = RADAR_RADIUS
    radarObjects.outline.Radius = RADAR_RADIUS
    radarObjects.dragHandle.Radius = RADAR_RADIUS
    radarObjects.loadOverlay.Radius = RADAR_RADIUS
    updateRadarLines()
end

local function setRadarPosition(newPos)
    radarPosition = newPos
    radarObjects.main.Position = newPos
    radarObjects.outline.Position = newPos
    radarObjects.loadOverlay.Position = newPos
    radarObjects.loadText.Position = newPos - newV2(0, 15)
    updateRadarLines()
    radarObjects.hoverText.Position = newPos
end

--- HỆ THỐNG PHÁT HIỆN KÉO THẢ CHO CẢ PC (MOUSE) & MOBILE (TOUCH) ---
local radarDragging = false
local currentTouchInput = nil

scriptCns.inputBegan = inputService.InputBegan:Connect(function(io)
    local inputType = io.UserInputType.Name
    if inputType == 'Keyboard' then
        local keyCode = io.KeyCode.Name
        if keyCode == 'End' then 
            _G.RadarKill()
        elseif keyCode == 'Equals' then
            radarObjects.zoomText.Position = radarPosition + newV2(0, RADAR_RADIUS + 15)
            radarObjects.zoomText.Visible = true
            scriptCns.zoomIn = runService.Heartbeat:Connect(function(dt)
                RADAR_SCALE = math.clamp(RADAR_SCALE + (dt * 1.2), 0.05, 5)
                radarObjects.zoomText.Text = string.format('Scale: %.2f', RADAR_SCALE)
                setRadarScale()
            end)
        elseif keyCode == 'Minus' then
            radarObjects.zoomText.Position = radarPosition + newV2(0, RADAR_RADIUS + 15)
            radarObjects.zoomText.Visible = true
            scriptCns.zoomOut = runService.Heartbeat:Connect(function(dt)
                RADAR_SCALE = math.clamp(RADAR_SCALE - (dt * 1.2), 0.05, 5)
                radarObjects.zoomText.Text = string.format('Scale: %.2f', RADAR_SCALE)
                setRadarScale()
            end)
        elseif keyCode == 'LeftBracket' then
            radarObjects.zoomText.Position = radarPosition + newV2(0, RADAR_RADIUS + 15)
            radarObjects.zoomText.Visible = true
            scriptCns.sizeDown = runService.Heartbeat:Connect(function(dt)
                RADAR_RADIUS = math.clamp(RADAR_RADIUS - (dt * 50), 50, 400)
                radarObjects.zoomText.Text = string.format('Radar Size: %d', RADAR_RADIUS)
                updateRadarSize()
            end)
        elseif keyCode == 'RightBracket' then
            radarObjects.zoomText.Position = radarPosition + newV2(0, RADAR_RADIUS + 15)
            radarObjects.zoomText.Visible = true
            scriptCns.sizeUp = runService.Heartbeat:Connect(function(dt)
                RADAR_RADIUS = math.clamp(RADAR_RADIUS + (dt * 50), 50, 400)
                radarObjects.zoomText.Text = string.format('Radar Size: %d', RADAR_RADIUS)
                updateRadarSize()
            end)
        end
    elseif inputType == 'MouseButton1' or inputType == 'Touch' then
        local startPos = (inputType == 'Touch') and newV2(io.Position.X, io.Position.Y) or inputService:GetMouseLocation()
        if (startPos - radarPosition).Magnitude < RADAR_RADIUS then
            radarDragging = true
            if inputType == 'Touch' then currentTouchInput = io end
            radarObjects.dragHandle.Position = radarPosition
            radarObjects.dragHandle.Visible = true
            
            scriptCns.dragCn = inputService.InputChanged:Connect(function(i)
                if (i.UserInputType.Name == 'MouseMovement' and not currentTouchInput) or (i.UserInputType.Name == 'Touch' and i == currentTouchInput) then
                    local movePos = (i.UserInputType.Name == 'Touch') and newV2(i.Position.X, i.Position.Y) or inputService:GetMouseLocation()
                    radarObjects.dragHandle.Position = movePos
                    setRadarPosition(movePos)
                end
            end)
        end
    end
end)

scriptCns.inputEnded = inputService.InputEnded:Connect(function(io)
    local inputType = io.UserInputType.Name
    if inputType == 'Keyboard' then
        if scriptCns.zoomIn then scriptCns.zoomIn:Disconnect() end
        if scriptCns.zoomOut then scriptCns.zoomOut:Disconnect() end
        if scriptCns.sizeDown then scriptCns.sizeDown:Disconnect() end
        if scriptCns.sizeUp then scriptCns.sizeUp:Disconnect() end
        task.delay(1.5, function() if not radarDragging then radarObjects.zoomText.Visible = false end end)
    elseif (inputType == 'MouseButton1' and not currentTouchInput) or (inputType == 'Touch' and io == currentTouchInput) then
        if scriptCns.dragCn then scriptCns.dragCn:Disconnect() end
        radarDragging = false
        currentTouchInput = nil
        setRadarPosition(radarObjects.dragHandle.Position)
        radarObjects.dragHandle.Visible = false
    end
end)

--- Bộ lưu trữ Marker cho NPC ---
local npcMarkers = {}
local currentNPCMarkersCenter = {} -- Dùng để lưu trữ chính xác tâm vật thể phục vụ Hover
local hoverNPCName = nil

local function createNpcMarker()
    local mark = {}
    if USE_QUADS then
        mark.main = Drawing.new('Quad')
        mark.main.Filled = true
        mark.main.Thickness = 2
        mark.main.ZIndex = 303
        
        mark.stroke = Drawing.new('Quad')
        mark.stroke.Filled = false
        mark.stroke.Thickness = 2
        mark.stroke.ZIndex = 302
    else
        mark.main = Drawing.new('Circle')
        mark.main.Filled = true
        mark.main.NumSides = 20
        mark.main.ZIndex = 303
        
        mark.stroke = Drawing.new('Circle')
        mark.stroke.Filled = false
        mark.stroke.NumSides = 20
        mark.stroke.ZIndex = 302
    end
    mark.main.Color = RADAR_THEME.NPC_Marker
    mark.stroke.Color = RADAR_THEME.NPC_Marker
    
    table.insert(drawObjects, mark.main)
    table.insert(drawObjects, mark.stroke)
    return mark
end

scriptCns.mouseHover = inputService.InputChanged:Connect(function(input)
    if input.UserInputType.Name == 'MouseMovement' or input.UserInputType.Name == 'Touch' then
        local checkPos = (input.UserInputType.Name == 'Touch') and newV2(input.Position.X, input.Position.Y) or inputService:GetMouseLocation()
        if (checkPos - radarPosition).Magnitude < RADAR_RADIUS then
            local closestDist = 15
            hoverNPCName = nil
            for npc, centerPos in pairs(currentNPCMarkersCenter) do
                local dist = (checkPos - centerPos).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    hoverNPCName = npc.Name
                end
            end
            if not hoverNPCName then radarObjects.hoverText.Visible = false end
        else
            hoverNPCName = nil
            radarObjects.hoverText.Visible = false
        end
    end
end)

--- TỐI ƯU HÓA: Quét NPC ngầm (Background thread) chạy mỗi 0.5 giây tránh lag ---
local activeNPCs = {}
task.spawn(function()
    while task.wait(0.5) do
        if not clientPlayer then break end
        local myChar = clientPlayer.Character
        local tempNPCs = {}
        
        local success, err = pcall(function()
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj ~= myChar and not players:GetPlayerFromCharacter(obj) then
                    local hrp = obj:FindFirstChild("HumanoidRootPart")
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if hrp and (not hum or hum.Health > 0) then
                        tempNPCs[obj] = hrp
                    end
                end
            end
        end)
        
        if success then
            activeNPCs = tempNPCs
        end
    end
end)

--- MAIN RADAR LOOP ---
local function cartToPolar(x, y) return math.sqrt(x^2 + y^2), math.atan2(y, x) end
local function polarToCart(r, t) return r * mathCos(t), r * mathSin(t) end

local finalLookVec = Vector3.zero
local textOffset = newV2(0, 5)

scriptCns.radarLoop = runService.Heartbeat:Connect(function(dt)
    if not clientRoot then return end
    
    local camAngle = 0
    if RADAR_ROTATION then
        local camLook = clientCamera.CFrame.LookVector
        local fixedLook = newV3(camLook.X, 0, camLook.Z).Unit
        finalLookVec = SMOOTH_ROT and finalLookVec:Lerp(fixedLook, 1 - mathExp(-SMOOTH_ROT_AMNT * dt)) or fixedLook
        camAngle = math.atan2(finalLookVec.X, finalLookVec.Z)
    end
    
        -- Vertical and horizontal lines (Fixed Cardinal Math)
        do 
            if ( RADAR_LINES ) then
                local cosA, sinA = mathCos(-camAngle), mathSin(-camAngle)
                local posN = radarPosition + newV2(sinA, -cosA) * RADAR_RADIUS
                local posS = radarPosition + newV2(-sinA, cosA) * RADAR_RADIUS
                local posE = radarPosition + newV2(cosA, sinA) * RADAR_RADIUS
                local posW = radarPosition + newV2(-cosA, -sinA) * RADAR_RADIUS
                
                radarObjects.verticalLine.From = posN;   radarObjects.verticalLine.To = posS
                radarObjects.horizontalLine.From = posW; radarObjects.horizontalLine.To = posE
                
                if CARDINAL_DISPLAY then
                    -- Khoảng cách từ chữ đến rìa đường tròn (Thay đổi số 12 nếu muốn chữ xa/gần hơn)
                    local padding = 0
                    
                    -- Nhân khoảng cách trực tiếp với Vector xoay và trừ đi bán kính Font chữ để căn giữa chữ Y
                    radarObjects.directionN.Position = radarPosition + newV2(sinA, -cosA) * (RADAR_RADIUS + padding) - newV2(0, 8)
                    radarObjects.directionS.Position = radarPosition + newV2(-sinA, cosA) * (RADAR_RADIUS + padding) - newV2(0, 7)
                    radarObjects.directionE.Position = radarPosition + newV2(cosA, sinA) * (RADAR_RADIUS + padding) - newV2(0, 7)
                    radarObjects.directionW.Position = radarPosition + newV2(-cosA, -sinA) * (RADAR_RADIUS + padding) - newV2(0, 7)
                end
            end
        end
        
    
    if USE_QUADS then
        local pLook = clientRoot.CFrame.LookVector
        local rotAngle = (math.atan2(pLook.X, pLook.Z) - camAngle) - math.rad(90)
        local c, s = mathCos(rotAngle), mathSin(rotAngle)
        local function rotQ(p) return radarPosition + newV2((p.X * s) - (p.Y * c), (p.X * c) + (p.Y * s)) end
        radarObjects.localMark.PointA = rotQ(quadPointA); radarObjects.localMark.PointB = rotQ(quadPointB); radarObjects.localMark.PointC = rotQ(quadPointC); radarObjects.localMark.PointD = rotQ(quadPointD)
        radarObjects.localMarkStroke.PointA = radarObjects.localMark.PointA; radarObjects.localMarkStroke.PointB = radarObjects.localMark.PointB; radarObjects.localMarkStroke.PointC = radarObjects.localMark.PointC; radarObjects.localMarkStroke.PointD = radarObjects.localMark.PointD
    else
        radarObjects.localMark.Position = radarPosition; radarObjects.localMarkStroke.Position = radarPosition
    end
    
    -- Xóa các Marker của NPC không còn tồn tại
    table.clear(currentNPCMarkersCenter)
    for npc, mark in pairs(npcMarkers) do
        if not activeNPCs[npc] or not activeNPCs[npc].Parent then
            removeDrawObj(mark.main)
            removeDrawObj(mark.stroke)
            npcMarkers[npc] = nil
        end
    end
    
    -- Cập nhật Marker NPC thời gian thực
    for npc, hrp in pairs(activeNPCs) do
        if not hrp.Parent then continue end
        local mark = npcMarkers[npc]
        if not mark then
            mark = createNpcMarker()
            npcMarkers[npc] = mark
        end
        
        local posDelta = hrp.Position - clientRoot.Position
        local radius, angle = cartToPolar(posDelta.X, posDelta.Z)
        local fixedRadius = radius * RADAR_SCALE
        
        if fixedRadius > RADAR_RADIUS then
            if DISPLAY_OFFSCREEN then
                mark.main.Transparency = OFFSCREEN_TRANSPARENCY; mark.stroke.Transparency = OFFSCREEN_TRANSPARENCY
                mark.main.Visible = true; mark.stroke.Visible = true
            else
                mark.main.Visible = false; mark.stroke.Visible = false
                continue
            end
        else
            mark.main.Visible = true; mark.stroke.Visible = true
            mark.main.Transparency = 1; mark.stroke.Transparency = 1
        end
        
        radius = math.clamp(fixedRadius, 0, RADAR_RADIUS)
        angle += (camAngle + math.rad(180))
        local x, y = polarToCart(radius, angle)
        local finalPos = radarPosition + newV2(x, y)
        currentNPCMarkersCenter[npc] = finalPos -- Lưu vị trí chính xác phục vụ hover
        
        if USE_QUADS then
            local rotAngle = (math.atan2(hrp.CFrame.LookVector.X, hrp.CFrame.LookVector.Z)) - math.rad(90) - camAngle
            local c, s = mathCos(rotAngle), mathSin(rotAngle)
            local fA, fB, fC, fD = quadPointA, quadPointB, quadPointC, quadPointD
            
            if MARKER_FALLOFF then
                local falloff = math.clamp(MARKER_FALLOFF_AMNT / posDelta.Magnitude, 0.75, 1)
                fA *= falloff; fB *= falloff; fC *= falloff; fD *= falloff
            end
            
            mark.main.PointA = finalPos + newV2((fA.X * s) - (fA.Y * c), (fA.X * c) + (fA.Y * s))
            mark.main.PointB = finalPos + newV2((fB.X * s) - (fB.Y * c), (fB.X * c) + (fB.Y * s))
            mark.main.PointC = finalPos + newV2((fC.X * s) - (fC.Y * c), (fC.X * c) + (fC.Y * s))
            mark.main.PointD = finalPos + newV2((fD.X * s) - (fD.Y * c), (fD.X * c) + (fD.Y * s))
            
            mark.stroke.PointA = mark.main.PointA; mark.stroke.PointB = mark.main.PointB; mark.stroke.PointC = mark.main.PointC; mark.stroke.PointD = mark.main.PointD
        else
            local dotRadius = markerScale * 3
            if MARKER_FALLOFF then dotRadius *= math.clamp(MARKER_FALLOFF_AMNT / posDelta.Magnitude, 0.75, 1) end
            mark.main.Radius = dotRadius; mark.main.Position = finalPos
            mark.stroke.Radius = dotRadius; mark.stroke.Position = finalPos
        end
        
        if hoverNPCName and hoverNPCName == npc.Name then
            radarObjects.hoverText.Text = string.format('%s\n[%d studs]', npc.Name, posDelta.Magnitude)
            radarObjects.hoverText.Visible = true
            radarObjects.hoverText.Position = radarObjects.hoverText.Position:Lerp(finalPos + textOffset, 1 - mathExp(-30 * dt))
        end
    end
end)

