        local mark = playerMarks[player.Name]
        local manager = playerManagers[player.Name]
        if ( manager ) then 
            manager.Friended = false 
            if ( mark ) then 
                local color = DISPLAY_TEAM_COLORS and (player.Team and player.Team.TeamColor.Color or player.TeamColor.Color) or RADAR_THEME.Generic_Marker
                mark.main.Color = color; mark.stroke.Color = color
            end
        end
    end)
end

--- Giải Phóng Bộ Nhớ Hoàn Toàn (Kill Script) ---
_G.RadarKill = function()
    if ( destroying ) then return end 
    destroying = true
    
    for _, con in pairs(scriptCns) do con:Disconnect() end
    
    if TRACK_PLAYERS then
        for name, manager in pairs(playerManagers) do 
            for _, con in pairs(manager.Cns) do con:Disconnect() end
        end
    end
    
    for _, obj in ipairs(drawObjects) do pcall(function() obj:Remove() end) end
    
    table.clear(drawObjects)
    table.clear(playerManagers)
    table.clear(playerMarks)
    table.clear(npcMarkers)
    table.clear(radarLines)
    table.clear(activeNPCs)
    table.clear(currentNPCMarkersCenter)
    table.clear(breadcrumbs)
    table.clear(breadcrumbVisuals)
    
    _G.RadarKill = nil
end
