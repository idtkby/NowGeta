--- PLAYER MANAGER (Xử lý Người chơi) --- 
local playerManagers = {}
if TRACK_PLAYERS then
    local function readyPlayer(thisPlayer) 
        if playerManagers[thisPlayer.Name] then return end 
        local thisName = thisPlayer.Name
        local thisManager = { Cns = {} }
        
        local function deathFunc() if ( thisManager.onDeath ) then thisManager.onDeath() end end

        thisManager.Cns['chr-add'] = thisPlayer.CharacterAdded:Connect(function(newChar)
            thisManager.Character = newChar
            thisManager.Humanoid = newChar:WaitForChild('Humanoid', 10)
            thisManager.RootPart = newChar:WaitForChild('HumanoidRootPart', 10)
            if ( thisManager.onRespawn ) then thisManager.onRespawn() end
            if ( thisManager.Cns['chr-die'] ) then thisManager.Cns['chr-die']:Disconnect() end
            if ( thisManager.Humanoid ) then thisManager.Cns['chr-die'] = thisManager.Humanoid.Died:Connect(deathFunc) end
        end)

        thisManager.Cns['chr-remove'] = thisPlayer.CharacterRemoving:Connect(function()
            if ( thisManager.onRemoval ) then thisManager.onRemoval() end
            thisManager.Character = nil; thisManager.RootPart = nil; thisManager.Humanoid = nil 
        end)
        
        thisManager.Cns['team'] = thisPlayer:GetPropertyChangedSignal('Team'):Connect(function()
            thisManager.Team = thisPlayer.Team
            if ( thisManager.onTeamChange ) then thisManager.onTeamChange(thisManager.Team) end
        end)
        
        if ( thisPlayer.Character ) then
            local Character = thisPlayer.Character
            thisManager.Character = Character
            thisManager.Humanoid = Character:FindFirstChildOfClass('Humanoid')
            thisManager.RootPart = Character:FindFirstChild('HumanoidRootPart')
            if ( thisManager.Humanoid ) then thisManager.Cns['chr-die'] = thisManager.Humanoid.Died:Connect(deathFunc) end
        end
        
        thisManager.Team = thisPlayer.Team; thisManager.Player = thisPlayer; thisManager.Name = thisName; thisManager.DisplayName = thisPlayer.DisplayName  
        thisManager.Friended = clientPlayer:IsFriendsWith(thisPlayer.UserId)
        
        thisManager.GetCFrame = function()
            local root = thisManager.RootPart
            if root and root.Parent then return root.CFrame end
            local char = thisPlayer.Character or thisManager.Character
            if char and char.Parent then
                local newRoot = char:FindFirstChild("HumanoidRootPart")
                if newRoot then thisManager.RootPart = newRoot; return newRoot.CFrame end
                return char:GetPivot()
            end
            return nil
        end
        
        playerManagers[thisName] = thisManager
    end
    
    local function removePlayer(player) 
        local thisName = player.Name
        local thisManager = playerManagers[thisName]
        if ( not thisManager ) then return end
        if ( thisManager.onLeave ) then thisManager.onLeave() end
        for _, con in pairs(thisManager.Cns) do con:Disconnect() end
        playerManagers[thisName] = nil 
    end

    for _, player in ipairs(playerService:GetPlayers()) do if ( player ~= clientPlayer ) then readyPlayer(player) end end
    scriptCns.pm_playerAdd = playerService.PlayerAdded:Connect(readyPlayer)
    scriptCns.pm_playerRemove = playerService.PlayerRemoving:Connect(removePlayer)

    task.spawn(function()
        while true do
            task.wait(1.5)
            for _, player in ipairs(playerService:GetPlayers()) do
                if player ~= clientPlayer then
                    local manager = playerManagers[player.Name]
                    if not manager then
                        readyPlayer(player)
                    else
                        if player.Character and (not manager.Character or not manager.RootPart) then
                            manager.Character = player.Character
                            manager.RootPart = player.Character:FindFirstChild("HumanoidRootPart")
                            manager.Humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                            if manager.onRespawn then manager.onRespawn() end
                        end
                    end
                end
            end
        end
    end)
end

