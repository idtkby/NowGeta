radarObjects.outline = newDrawObj('Circle', {Color = RADAR_THEME.Outline; Position = radarPosition; Filled = false; Visible = true; NumSides = 40; Thickness = 5; Radius = RADAR_RADIUS; ZIndex = 299;})
radarObjects.dragHandle = newDrawObj('Circle', {Color = RADAR_THEME.DragHandle; Position = radarPosition; Filled = false; Visible = false; NumSides = 40; Radius = RADAR_RADIUS; Thickness = 3; ZIndex = 325;})
radarObjects.loadOverlay = newDrawObj('Circle', {Color = Color3.new(0,0,0); Filled = true; NumSides = 40; Position = radarPosition; Radius = RADAR_RADIUS; Transparency = 0.5; Visible = clientRoot == nil; ZIndex = 319;})
radarObjects.loadText = newDrawObj('Text', {Center = true; Color = Color3.new(1,1,1); Font = Drawing.Fonts.UI; Outline = true; Position = radarPosition - newV2(0, 15); Size = 18; Text = 'Waiting for spawn...'; Visible = clientRoot == nil; ZIndex = 320;})
radarObjects.zoomText = newDrawObj('Text', {Center = true; Color = Color3.new(1,1,1); Font = Drawing.Fonts.UI; Outline = true; Size = 16; Transparency = 0; Visible = false; ZIndex = 306;})
radarObjects.hoverText = newDrawObj('Text', {Center = true; Color = Color3.new(1,1,1); Font = Drawing.Fonts.UI; Outline = true; Position = radarPosition; Size = 15; Visible = false; ZIndex = 306;})

if ( USE_QUADS ) then 
