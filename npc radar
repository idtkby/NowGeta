_G.RadarKill = function()
    clientPlayer = nil
    for _, con in pairs(scriptCns) do con:Disconnect() end
    for _, obj in ipairs(drawObjects) do pcall(function() obj:Remove() end) end
    for _, mark in pairs(npcMarkers) do 
        pcall(function() mark.main:Remove() end)
        pcall(function() mark.stroke:Remove() end)
    end
    for _, l in ipairs(radarLines) do pcall(function() l:Remove() end) end
    table.clear(drawObjects)
    table.clear(npcMarkers)
    table.clear(radarLines)
    table.clear(activeNPCs)
    table.clear(currentNPCMarkersCenter)
    _G.RadarKill = nil
end
	