local scriptCns = {}
local radarObjects = {}
local drawObjects = {}

local markerScale = math.clamp(RADAR_SCALE, MARKER_SCALE_MIN, MARKER_SCALE_MAX) * MARKER_SCALE_BASE
local scaleVec = newV2(markerScale, markerScale)

local quadPointA = newV2(0, 5)   * scaleVec
local quadPointB = newV2(4, -5)  * scaleVec
local quadPointC = newV2(0, -3)  * scaleVec
local quadPointD = newV2(-4, -5) * scaleVec

local function newDrawObj(objectClass, objectProperties)
    local obj = Drawing.new(objectClass)
    table.insert(drawObjects, obj)
    for i, v in pairs(objectProperties) do obj[i] = v end
    return obj
end

-- Hàm xóa Drawing Object an toàn tránh rò rỉ bộ nhớ
local function removeDrawObj(obj)
    local idx = table.find(drawObjects, obj)
    if idx then table.remove(drawObjects, idx) end
    obj:Remove()
end

-- Đã sửa lỗi: Hỗ trợ Lerp cho cả Number (Transparency)
local function tweenExp(obj, property, dest, duration) 
    task.spawn(function()
        local initialVal = obj[property]
        local tweenTime = 0
        while ( tweenTime < duration ) do 
            local alpha = 1 - math.pow(2, -10 * tweenTime / duration)
            if type(initialVal) == "number" then
                obj[property] = initialVal + (dest - initialVal) * alpha
            else
                obj[property] = initialVal:Lerp(dest, alpha)
            end
            tweenTime += task.wait()
        end
        obj[property] = dest
    end)
end

