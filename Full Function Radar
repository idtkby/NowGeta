-- Thiết lập Player Marks
if TRACK_PLAYERS then
    local function initMark(thisPlayer)
        local thisName = thisPlayer.Name 
        local thisManager = playerManagers[thisName]
        if ( not thisManager ) then return end
        
        local markers = createGenericMarker()
        
        thisManager.onDeath = function() markers.main.Filled = false end
        thisManager.onRespawn = function() markers.main.Filled = true; markers.main.Visible = true; markers.stroke.Visible = true end
        thisManager.onRemoval = function() markers.main.Visible = false; markers.stroke.Visible = false end
        thisManager.onLeave = function()
            removeDrawObj(markers.main)
            removeDrawObj(markers.stroke)
            playerMarks[thisName] = nil
        end
        
        local function getPlayerColor(player, manager, team)
            if DISPLAY_FRIEND_COLORS and manager.Friended then return RADAR_THEME.Friend_Marker end
            if DISPLAY_TEAM_COLORS then
                if team and team:IsA("Team") then return team.TeamColor.Color
                elseif player.TeamColor then return player.TeamColor.Color end
                if team == clientTeam then return RADAR_THEME.Team_Marker else return RADAR_THEME.Generic_Marker end
            end
            return RADAR_THEME.Generic_Marker
        end

        if ( DISPLAY_TEAM_COLORS ) then 
            thisManager.onTeamChange = function(team) 
                if ( DISPLAY_FRIEND_COLORS and thisManager.Friended ) then return end
                local color = getPlayerColor(thisPlayer, thisManager, team)
                markers.main.Color = color; markers.stroke.Color = color
            end
        end 
        
        local initColor = getPlayerColor(thisPlayer, thisManager, thisPlayer.Team)
        markers.main.Color = initColor; markers.stroke.Color = initColor 

        if ( thisManager.Humanoid and thisManager.Humanoid.Health == 0 ) then thisManager.onDeath() end
        playerMarks[thisName] = markers
    end
    
    for _, manager in pairs(playerManagers) do initMark(manager.Player) end
    scriptCns.addMarks = playerService.PlayerAdded:Connect(function(player) task.wait(0.3); initMark(player) end)
end

--- Hover Target System ---
local hoverPlayerName = nil
local hoverNPCInstance = nil
do 
    local lastCheckTime = 0
    scriptCns.inputChanged = inputService.InputChanged:Connect(function(input) 
        local nowTime = tick() 
        local inputType = input.UserInputType.Name

        if ( nowTime - lastCheckTime > 0.03 and (inputType == 'MouseMovement' or inputType == 'Touch') ) then
            lastCheckTime = nowTime
            local mousePos = (inputType == 'Touch') and newV2(input.Position.X, input.Position.Y) or inputService:GetMouseLocation()
            
            if ( (mousePos - radarPosition).Magnitude < RADAR_RADIUS ) then
                local distanceThresh = 20 
                hoverPlayerName = nil
                hoverNPCInstance = nil
                
                if TRACK_PLAYERS then
                    for thisName, thisMark in pairs(playerMarks) do 
                        if thisMark and thisMark.main.Visible then
                            local markPos = thisMark.main[USE_QUADS and 'PointD' or 'Position']
                            local distance = (mousePos - markPos).Magnitude
                            if ( distance < distanceThresh ) then
                                distanceThresh = distance
                                hoverPlayerName = thisName
                            end
                        end
                    end
                end
                
                if TRACK_NPCS and not hoverPlayerName then
                    for npc, centerPos in pairs(currentNPCMarkersCenter) do
                        local mark = npcMarkers[npc]
                        if mark and mark.main.Visible then
                            local distance = (mousePos - centerPos).Magnitude
                            if distance < distanceThresh then
                                distanceThresh = distance
                                hoverNPCInstance = npc
                            end
                        end
                    end
                end
                
                if not hoverPlayerName and not hoverNPCInstance then radarObjects.hoverText.Visible = false end
            else
                hoverPlayerName = nil; hoverNPCInstance = nil; radarObjects.hoverText.Visible = false 
            end
        end
    end)
end

--- Core Math Polar Loops ---
local function cartToPolar(x, y) return math.sqrt(x^2 + y^2), math.atan2(y, x) end
local function polarToCart(r, t) return r * mathCos(t), r * mathSin(t) end

local destroying = false 
local breadcrumbs = {}
local breadcrumbVisuals = {}
local lastRecordedPos = nil

local finalLookVec = Vector3.zero
local textOffset = newV2(0, 5)
local rad90 = math.rad(90)
local rad180 = math.rad(180)

local rayParams
if ( VISIBLITY_CHECK ) then
    rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { clientPlayer.Character }
    scriptCns.rayUpdate = clientPlayer.CharacterAdded:Connect(function(newChar) rayParams.FilterDescendantsInstances = { newChar } end)
end

scriptCns.radarLoop = runService.Heartbeat:Connect(function(deltaTime) 
    if ( not clientRoot or not clientRoot.Parent ) then 
        if clientPlayer.Character and clientPlayer.Character:FindFirstChild("HumanoidRootPart") then
            clientRoot = clientPlayer.Character.HumanoidRootPart
            radarObjects.loadText.Visible = false 
            radarObjects.loadOverlay.Visible = false
        else
            return 
        end
    end

    local selfPos = clientRoot.Position
    local cameraPos = clientCamera.CFrame.Position
    local camAngle = 0 

    if ( RADAR_ROTATION ) then 
        local cameraLookVec = clientCamera.CFrame.LookVector
        local fixedLookVec = newV3(cameraLookVec.X, 0, cameraLookVec.Z).Unit
        finalLookVec = SMOOTH_ROT and finalLookVec:Lerp(fixedLookVec, 1 - mathExp(-SMOOTH_ROT_AMNT * deltaTime)) or fixedLookVec
        camAngle = math.atan2(finalLookVec.X, finalLookVec.Z)
    else
        camAngle = rad180
    end
    
    -- Xử lý đường lưới & Cardinal
    if ( RADAR_LINES ) then
        local cosA, sinA = mathCos(-camAngle), mathSin(-camAngle)
        local posN = radarPosition + newV2(sinA, -cosA) * RADAR_RADIUS
        local posS = radarPosition + newV2(-sinA, cosA) * RADAR_RADIUS
        local posE = radarPosition + newV2(cosA, sinA) * RADAR_RADIUS
        local posW = radarPosition + newV2(-cosA, -sinA) * RADAR_RADIUS
        
        radarObjects.verticalLine.From = posN;   radarObjects.verticalLine.To = posS
        radarObjects.horizontalLine.From = posW; radarObjects.horizontalLine.To = posE
        
        if CARDINAL_DISPLAY then
            radarObjects.directionN.Position = radarPosition + newV2(sinA, -cosA) * RADAR_RADIUS - newV2(0, 8)
            radarObjects.directionS.Position = radarPosition + newV2(-sinA, cosA) * RADAR_RADIUS - newV2(0, 7)
            radarObjects.directionE.Position = radarPosition + newV2(cosA, sinA) * RADAR_RADIUS - newV2(0, 7)
            radarObjects.directionW.Position = radarPosition + newV2(-cosA, -sinA) * RADAR_RADIUS - newV2(0, 7)
        end
    end

    -- Cập nhật LocalPlayer Mark
    local localMark = radarObjects.localMark
    local localMarkStroke = radarObjects.localMarkStroke
    if ( USE_QUADS ) then
        local playerLookVec = clientRoot.CFrame.LookVector
        local angle = (math.atan2(playerLookVec.X, playerLookVec.Z) - camAngle) - rad90
        local angleCos, angleSin = mathCos(angle), mathSin(angle)
        
        local fixedA = radarPosition + newV2((quadPointA.X * angleSin) - (quadPointA.Y * angleCos), (quadPointA.X * angleCos) + (quadPointA.Y * angleSin))
        local fixedB = radarPosition + newV2((quadPointB.X * angleSin) - (quadPointB.Y * angleCos), (quadPointB.X * angleCos) + (quadPointB.Y * angleSin))
        local fixedC = radarPosition + newV2((quadPointC.X * angleSin) - (quadPointC.Y * angleCos), (quadPointC.X * angleCos) + (quadPointC.Y * angleSin))
        local fixedD = radarPosition + newV2((quadPointD.X * angleSin) - (quadPointD.Y * angleCos), (quadPointD.X * angleCos) + (quadPointD.Y * angleSin))
        
        localMark.PointA = fixedA; localMark.PointB = fixedB; localMark.PointC = fixedC; localMark.PointD = fixedD
        localMarkStroke.PointA = fixedA; localMarkStroke.PointB = fixedB; localMarkStroke.PointC = fixedC; localMarkStroke.PointD = fixedD
    else
        localMark.Position = radarPosition; localMarkStroke.Position = radarPosition
    end

    -- Breadcrumbs (Ghi vết đường đi cũ)
    if settings.RECORD_PATH then
        if not lastRecordedPos or (selfPos - lastRecordedPos).Magnitude >= settings.PATH_DISTANCE then
            lastRecordedPos = selfPos
            table.insert(breadcrumbs, selfPos)
            local obj = newDrawObj('Circle', {Color = settings.PATH_COLOR; Filled = true; NumSides = 4; Radius = math.clamp(1.5 * RADAR_SCALE, 1, 4); Visible = false; ZIndex = 301;})
            table.insert(breadcrumbVisuals, obj)
            
            if #breadcrumbs > settings.PATH_MAX_POINTS then
                local oldObj = table.remove(breadcrumbVisuals, 1)
                if oldObj then removeDrawObj(oldObj) end
                table.remove(breadcrumbs, 1)
            end
        end
        for i, worldPos in ipairs(breadcrumbs) do
            local visual = breadcrumbVisuals[i]
            if visual then
                local posDelta = worldPos - selfPos
                local radius, angle = cartToPolar(posDelta.X, posDelta.Z)
                local fixedRadius = radius * RADAR_SCALE
                if fixedRadius > RADAR_RADIUS then visual.Visible = false else
                    visual.Visible = true
                    visual.Radius = math.clamp(1.5 * RADAR_SCALE, 1, 4)
                    angle += (camAngle + rad180)
                    local x, y = polarToCart(fixedRadius, angle)
                    visual.Position = radarPosition + newV2(x, y)
                end
            end
        end
    end

    --- VÒNG LẶP CẬP NHẬT NGƯỜI CHƠI ---
    if TRACK_PLAYERS then
        for thisName, thisManager in pairs(playerManagers) do 
            local thisMark = playerMarks[thisName]
            if ( not thisMark ) then continue end
            local main, stroke = thisMark.main, thisMark.stroke 
            
            if ( DISPLAY_TEAMMATES == false and thisManager.Team == clientTeam ) then 
                main.Visible = false; stroke.Visible = false; continue
            end
            
            local cframe = thisManager:GetCFrame()
            if ( not cframe ) then 
                -- KIỂM TRA STREAMING: Tự ẩn đi nếu đối tượng văng khỏi khu vực nạp map
                main.Visible = false; stroke.Visible = false; continue 
            end 
            
            local position = cframe.Position 
            local posDelta = position - selfPos
            local radius, angle = cartToPolar(posDelta.X, posDelta.Z)
            local fixedRadius = radius * RADAR_SCALE 
            
            if ( fixedRadius > RADAR_RADIUS ) then
                if ( DISPLAY_OFFSCREEN ) then 
                    main.Transparency = OFFSCREEN_TRANSPARENCY; stroke.Transparency = OFFSCREEN_TRANSPARENCY
                else
                    main.Visible = false; stroke.Visible = false; continue
                end
            else
                main.Visible = true; stroke.Visible = true 
                if thisManager.Humanoid and thisManager.Humanoid.Health > 0 then
                    main.Filled = true; main.Transparency = 1; stroke.Transparency = 1
                else
                    main.Filled = false -- Chết lộ viền rỗng
                end
            end
            
            radius = math.clamp(fixedRadius, 0, RADAR_RADIUS)
            angle += (camAngle + rad180) 
            local x, y = polarToCart(radius, angle)
            local finalPos = radarPosition + newV2(x, y)
            
            if ( USE_QUADS ) then
                local playerLookVec = cframe.LookVector
                local angleQ = (math.atan2(playerLookVec.X, playerLookVec.Z)) - rad90 - camAngle
                local angleCos, angleSin = mathCos(angleQ), mathSin(angleQ)
                local fixedA = newV2((quadPointA.X * angleSin) - (quadPointA.Y * angleCos), (quadPointA.X * angleCos) + (quadPointA.Y * angleSin))
                local fixedB = newV2((quadPointB.X * angleSin) - (quadPointB.Y * angleCos), (quadPointB.X * angleCos) + (quadPointB.Y * angleSin))                
                local fixedC = newV2((quadPointC.X * angleSin) - (quadPointC.Y * angleCos), (quadPointC.X * angleCos) + (quadPointC.Y * angleSin))  
                local fixedD = newV2((quadPointD.X * angleSin) - (quadPointD.Y * angleCos), (quadPointD.X * angleCos) + (quadPointD.Y * angleSin))  
                if ( MARKER_FALLOFF ) then
                    local scaleFalloff = math.clamp(MARKER_FALLOFF_AMNT / posDelta.Magnitude, 0.75, 1)
                    fixedA *= scaleFalloff; fixedB *= scaleFalloff; fixedC *= scaleFalloff; fixedD *= scaleFalloff
                end
                main.PointA = finalPos + fixedA; main.PointB = finalPos + fixedB; main.PointC = finalPos + fixedC; main.PointD = finalPos + fixedD
                stroke.PointA = main.PointA; stroke.PointB = main.PointB; stroke.PointC = main.PointC; stroke.PointD = main.PointD
            else                    
                local dotRadius = markerScale * 3
                if ( MARKER_FALLOFF ) then dotRadius *= math.clamp(MARKER_FALLOFF_AMNT / posDelta.Magnitude, 0.75, 1) end
                main.Radius = dotRadius; main.Position = finalPos
                stroke.Radius = dotRadius; stroke.Position = finalPos
            end
            
            if ( hoverPlayerName == thisName ) then
                radarObjects.hoverText.Text = string.format('%s\n(%d studs)', thisManager.DisplayName, posDelta.Magnitude)
                radarObjects.hoverText.Size = math.clamp(16 * RADAR_SCALE, 16, 24); radarObjects.hoverText.Visible = true
                radarObjects.hoverText.Position = radarObjects.hoverText.Position:Lerp(finalPos + textOffset, 1 - mathExp(-30 * deltaTime))
            end
            
            if ( VISIBLITY_CHECK ) then
                local direction = ( position - cameraPos ).Unit * 12345
                local raycast = workspace:Raycast(cameraPos, direction, rayParams)
                if ( raycast and ( raycast.Position - position ).Magnitude > 4 ) then
                    main.Transparency /= 5; stroke.Transparency /= 5
                end 
            end
        end
    end

    --- VÒNG LẶP CẬP NHẬT NPC ---
    if TRACK_NPCS then
        table.clear(currentNPCMarkersCenter)
        
        -- Dọn sạch marker NPC lỗi thời (đã rời khu vực stream hoặc bị xóa)
        for npc, mark in pairs(npcMarkers) do
            if not activeNPCs[npc] or not activeNPCs[npc].Parent then
                removeDrawObj(mark.main)
                removeDrawObj(mark.stroke)
                npcMarkers[npc] = nil
            end
        end
        
        -- Tiến hành vẽ NPC còn hoạt động
        for npc, hrp in pairs(activeNPCs) do
            if not hrp.Parent then continue end
            local mark = npcMarkers[npc]
            if not mark then
                mark = createGenericMarker()
                mark.main.Color = RADAR_THEME.NPC_Marker
                mark.stroke.Color = RADAR_THEME.NPC_Marker
                npcMarkers[npc] = mark
            end
            
            local posDelta = hrp.Position - selfPos
            local radius, angle = cartToPolar(posDelta.X, posDelta.Z)
            local fixedRadius = radius * RADAR_SCALE
            
            if fixedRadius > RADAR_RADIUS then
                if DISPLAY_OFFSCREEN then
                    mark.main.Transparency = OFFSCREEN_TRANSPARENCY; mark.stroke.Transparency = OFFSCREEN_TRANSPARENCY
                    mark.main.Visible = true; mark.stroke.Visible = true
                else
                    mark.main.Visible = false; mark.stroke.Visible = false; continue
                end
            else
                mark.main.Visible = true; mark.stroke.Visible = true
                mark.main.Transparency = 1; mark.stroke.Transparency = 1
            end
            
            radius = math.clamp(fixedRadius, 0, RADAR_RADIUS)
            angle += (camAngle + rad180)
            local x, y = polarToCart(radius, angle)
            local finalPos = radarPosition + newV2(x, y)
            currentNPCMarkersCenter[npc] = finalPos
            
            if USE_QUADS then
                local rotAngle = (math.atan2(hrp.CFrame.LookVector.X, hrp.CFrame.LookVector.Z)) - rad90 - camAngle
                local c, s = mathCos(rotAngle), mathSin(rotAngle)
                local fA, fB, fC, fD = quadPointA, quadPointB, quadPointC, quadPointD
                
                if MARKER_FALLOFF then
                    local falloff = math.clamp(MARKER_FALLOFF_AMNT / posDelta.Magnitude, 0.75, 1)
                    fA *= falloff; fB *= falloff; fC *= falloff; fD *= falloff
                end
                
                mark.main.PointA = finalPos + newV2((fA.X * s) - (fA.Y * c), (fA.X * c) + (fA.Y * s))
                mark.main.PointB = finalPos + newV2((fB.X * s) - (fB.Y * c), (fB.X * c) + (fB.Y * s))
                mark.main.PointC = finalPos + newV2((fC.X * s) - (fC.Y * c), (fC.X * c) + (fC.Y * s))
                mark.main.PointD = finalPos + newV2((fD.X * s) - (fD.Y * c), (fD.X * c) + (fD.Y * s))
                mark.stroke.PointA = mark.main.PointA; mark.stroke.PointB = mark.main.PointB; mark.stroke.PointC = mark.main.PointC; mark.stroke.PointD = mark.main.PointD
            else
                local dotRadius = markerScale * 3
                if MARKER_FALLOFF then dotRadius *= math.clamp(MARKER_FALLOFF_AMNT / posDelta.Magnitude, 0.75, 1) end
                mark.main.Radius = dotRadius; mark.main.Position = finalPos
                mark.stroke.Radius = dotRadius; mark.stroke.Position = finalPos
            end
            
            if hoverNPCInstance and hoverNPCInstance == npc then
                radarObjects.hoverText.Text = string.format('%s\n[%d studs]', npc.Name, posDelta.Magnitude)
                radarObjects.hoverText.Size = math.clamp(16 * RADAR_SCALE, 16, 24); radarObjects.hoverText.Visible = true
                radarObjects.hoverText.Position = radarObjects.hoverText.Position:Lerp(finalPos + textOffset, 1 - mathExp(-30 * deltaTime))
            end
        end
    end
end)

if ( DISPLAY_RGB_COLORS and TRACK_PLAYERS ) then
    local hue = 0
    scriptCns.rgbLoop = runService.Heartbeat:Connect(function(deltaTime) 
        hue += deltaTime / 20
        if ( hue > 1 ) then hue -= 1 end
        local color = Color3.fromHSV(hue, 0.9, 0.9)
        for thisName, thisManager in pairs(playerManagers) do 
            local thisMark = playerMarks[thisName]
            if ( thisMark and not (DISPLAY_FRIEND_COLORS and thisManager.Friended) ) then 
                thisMark.main.Color = color; thisMark.stroke.Color = color 
            end
        end
    end)
end

